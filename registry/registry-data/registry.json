      {
        "key": "res",
        "label": "Spatial resolution / unit"
      },
      {
        "key": "licence",
        "label": "Licence"
      }
    ],
    "notes": [
      "Large files go to the HPC workspace (data/…), not this PC; folders in parentheses are on the HPC and not checked by the disk scan.",
      "Note the exact survey / release / year under “Version used”: results are only comparable when that is known.",
      "Never commit API keys (the Census KEY lives in .env).",
      "Socioeconomic variables are published per block group at the finest; finer units carry counts only."
    ],
    "deployment": {
      "mode": "tab",
      "port": 8010,
      "base_path": "/registry",
      "folder": "city_dashboard/registry",
      "data_root": "urban-tree-detection/data",
